{
    "name": "windows-housekeeper-toolkit",
    "version": "0.1.0",
    "private": true,
    "description": "Windows application cleanup, startup preferences, and data migration.",
    "bin": {
        "windows-housekeeper-toolkit": "./src/index.ts"
    },
    "type": "module",
    "scripts": {
        "start": "bun run src/index.ts",
        "scan": "bun run src/index.ts --dry-run --category general-cache --category destructive-cache --category windows-temp --category old-installations",
        "test": "bun test",
        "typecheck": "vp check --no-fmt --no-lint",
        "lint": "vp lint",
        "lint:fix": "vp lint --fix",
        "format": "vp fmt",
        "format:check": "vp fmt --check",
        "check": "vp check"
    },
    "dependencies": {
        "@clack/prompts": "1.7.0",
        "@optique/core": "1.2.4",
        "@optique/run": "1.2.4",
        "picocolors": "1.1.1"
    },
    "devDependencies": {
        "@types/bun": "1.4.0",
        "vite-plus": "1.5.1"
    },
    "engines": {
        "bun": ">=1.4.3"
    },
    "packageManager": "bun@1.4.3"
}

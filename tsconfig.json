{
    "compilerOptions": {
        "target": "ES2024",
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "lib": ["ES2024"],
        "types": ["bun"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "vite.config.ts"]
}
